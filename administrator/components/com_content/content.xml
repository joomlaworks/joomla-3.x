<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="3.1" method="upgrade">
    <name>com_content</name>
    <author>Joomla! Project</author>
    <creationDate>April 2006</creationDate>
    <copyright>(C) 2006 Open Source Matters, Inc.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.md</license>
    <authorEmail>admin@joomla.org</authorEmail>
    <authorUrl>www.joomla.org</authorUrl>
    <version>3.0.0</version>
    <description>COM_CONTENT_XML_DESCRIPTION</description>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/install.postgresql.utf8.sql</file>
            <file driver="sqlsrv" charset="utf8">sql/install.sqlsrv.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/uninstall.postgresql.utf8.sql</file>
            <file driver="sqlsrv" charset="utf8">sql/uninstall.sqlsrv.utf8.sql</file>
        </sql>
    </uninstall>
    <files folder="site">
        <filename>content.php</filename>
        <filename>controller.php</filename>
        <filename>router.php</filename>
        <folder>helpers</folder>
        <folder>models</folder>
    </files>
    <media folder="media">
        <folder>com_content</folder>
    </media>
    <languages folder="site">
        <language tag="en-GB">language/en-GB.com_content.ini</language>
    </languages>
    <administration>
        <files folder="admin">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>content.php</filename>
            <filename>controller.php</filename>
            <folder>controllers</folder>
            <folder>helpers</folder>
            <folder>models</folder>
            <folder>tables</folder>
            <folder>views</folder>
            <folder>sql</folder>
        </files>
        <languages folder="admin">
            <language tag="en-GB">language/en-GB.com_content.ini</language>
            <language tag="en-GB">language/en-GB.com_content.sys.ini</language>
        </languages>
    </administration>
    <!-- Extensions which only serve this component, uninstalled with it ("Restore uninstalled core extensions" in Joomla Update brings them back); a shared one stays while another component listing it is installed -->
    <companions>
        <module element="mod_articles_archive" client="site" />
        <module element="mod_articles_categories" client="site" />
        <module element="mod_articles_category" client="site" />
        <module element="mod_articles_latest" client="site" />
        <module element="mod_articles_news" client="site" />
        <module element="mod_articles_popular" client="site" />
        <module element="mod_related_items" client="site" />
        <module element="mod_latest" client="administrator" />
        <module element="mod_popular" client="administrator" />
        <plugin group="content" element="pagebreak" />
        <plugin group="content" element="pagenavigation" />
        <plugin group="content" element="vote" />
        <plugin group="editors-xtd" element="article" />
        <plugin group="editors-xtd" element="pagebreak" />
        <plugin group="editors-xtd" element="readmore" />
        <plugin group="finder" element="content" />
        <plugin group="privacy" element="content" />
        <plugin group="search" element="content" />
        <plugin group="content" element="confirmconsent" />
        <plugin group="sampledata" element="blog" />
        <plugin group="system" element="privacyconsent" />
        <plugin group="user" element="terms" />
    </companions>
</extension>

