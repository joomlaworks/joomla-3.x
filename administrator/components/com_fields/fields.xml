<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="3.7.0" method="upgrade">
    <name>com_fields</name>
    <author>Joomla! Project</author>
    <creationDate>March 2016</creationDate>
    <copyright>(C) 2016 Open Source Matters, Inc.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.md</license>
    <authorEmail>admin@joomla.org</authorEmail>
    <authorUrl>www.joomla.org</authorUrl>
    <version>3.7.0</version>
    <description>COM_FIELDS_XML_DESCRIPTION</description>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/install.postgresql.utf8.sql</file>
            <file driver="sqlsrv" charset="utf8">sql/install.sqlsrv.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/uninstall.postgresql.utf8.sql</file>
            <file driver="sqlsrv" charset="utf8">sql/uninstall.sqlsrv.utf8.sql</file>
        </sql>
    </uninstall>
    <files folder="site">
        <filename>controller.php</filename>
        <filename>fields.php</filename>
        <folder>layouts</folder>
    </files>
    <media folder="media">
        <folder>com_fields</folder>
    </media>
    <administration>
        <files folder="admin">
            <filename>controller.php</filename>
            <filename>fields.php</filename>
            <folder>controllers</folder>
            <folder>helpers</folder>
            <folder>libraries</folder>
            <folder>models</folder>
            <folder>tables</folder>
            <folder>views</folder>
            <folder>sql</folder>
        </files>
        <languages folder="admin">
            <language tag="en-GB">language/en-GB.com_fields.ini</language>
            <language tag="en-GB">language/en-GB.com_fields.sys.ini</language>
        </languages>
    </administration>
    <!-- Extensions which only serve this component, uninstalled with it ("Restore uninstalled core extensions" in Joomla Update brings them back); a shared one stays while another component listing it is installed -->
    <companions>
        <plugin group="content" element="fields" />
        <plugin group="editors-xtd" element="fields" />
        <plugin group="system" element="fields" />
        <plugin group="fields" element="calendar" />
        <plugin group="fields" element="checkboxes" />
        <plugin group="fields" element="color" />
        <plugin group="fields" element="editor" />
        <plugin group="fields" element="imagelist" />
        <plugin group="fields" element="integer" />
        <plugin group="fields" element="list" />
        <plugin group="fields" element="media" />
        <plugin group="fields" element="radio" />
        <plugin group="fields" element="repeatable" />
        <plugin group="fields" element="sql" />
        <plugin group="fields" element="text" />
        <plugin group="fields" element="textarea" />
        <plugin group="fields" element="url" />
        <plugin group="fields" element="user" />
        <plugin group="fields" element="usergrouplist" />
    </companions>
</extension>

