<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset addfieldpath="/administrator/components/com_modules/models/fields" />
    <fields name="filter">
        <field name="search" type="text" inputmode="search" label="COM_MODULES_FIELD_POSITION_LABEL" description="COM_MODULES_FILTER_SEARCH_DESC" hint="JSEARCH_FILTER" />
        <field name="state" type="list" label="JSTATUS" onchange="this.form.submit();">
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">JENABLED</option>
            <option value="0">JDISABLED</option>
        </field>
        <field name="type" type="list" label="COM_MODULES_OPTION_SELECT_TYPE" onchange="this.form.submit();">
            <option value="">COM_MODULES_OPTION_SELECT_TYPE</option>
            <option value="user">COM_MODULES_OPTION_POSITION_USER_DEFINED</option>
            <option value="template">COM_MODULES_OPTION_POSITION_TEMPLATE_DEFINED</option>
        </field>
        <field name="template" type="modulestemplate" label="JOPTION_SELECT_TEMPLATE" onchange="this.form.submit();">
            <option value="">JOPTION_SELECT_TEMPLATE</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="value ASC" validate="options">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="value ASC">COM_MODULES_HEADING_POSITION_ASC</option>
            <option value="value DESC">COM_MODULES_HEADING_POSITION_DESC</option>
            <option value="templates ASC">COM_MODULES_HEADING_TEMPLATES_ASC</option>
            <option value="templates DESC">COM_MODULES_HEADING_TEMPLATES_DESC</option>
        </field>
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" class="input-mini" default="25" onchange="this.form.submit();" />
    </fields>
</form>
