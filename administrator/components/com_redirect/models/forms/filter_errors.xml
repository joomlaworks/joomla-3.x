<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" inputmode="search" label="COM_REDIRECT_FILTER_ERRORS_SEARCH_LABEL" description="COM_REDIRECT_FILTER_ERRORS_SEARCH_DESC" hint="JSEARCH_FILTER" />
        <field name="code" type="sql" label="COM_REDIRECT_FILTER_CODE_LABEL" description="COM_REDIRECT_FILTER_CODE_DESC" query="SELECT DISTINCT code AS value, code AS text FROM #__redirect_errors ORDER BY code" key_field="value" value_field="text" onchange="this.form.submit();">
            <option value="">COM_REDIRECT_FILTER_SELECT_CODE</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" description="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="a.last_hit DESC" validate="options">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.url ASC">COM_REDIRECT_HEADING_URL_ASC</option>
            <option value="a.url DESC">COM_REDIRECT_HEADING_URL_DESC</option>
            <option value="a.code ASC">COM_REDIRECT_HEADING_CODE_ASC</option>
            <option value="a.code DESC">COM_REDIRECT_HEADING_CODE_DESC</option>
            <option value="a.hits ASC">COM_REDIRECT_HEADING_ERROR_HITS_ASC</option>
            <option value="a.hits DESC">COM_REDIRECT_HEADING_ERROR_HITS_DESC</option>
            <option value="a.referer ASC">COM_REDIRECT_HEADING_REFERRER_ASC</option>
            <option value="a.referer DESC">COM_REDIRECT_HEADING_REFERRER_DESC</option>
            <option value="a.created_date ASC">COM_REDIRECT_HEADING_FIRST_HIT_ASC</option>
            <option value="a.created_date DESC">COM_REDIRECT_HEADING_FIRST_HIT_DESC</option>
            <option value="a.last_hit ASC">COM_REDIRECT_HEADING_LAST_HIT_ASC</option>
            <option value="a.last_hit DESC">COM_REDIRECT_HEADING_LAST_HIT_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>
        <field name="limit" type="limitbox" label="JGLOBAL_LIMIT" description="JGLOBAL_LIMIT" class="input-mini" default="20" onchange="this.form.submit();" />
    </fields>
</form>
