<?xml version="1.0" encoding="utf-8"?>
<form addfieldpath="/administrator/components/com_redirect/models/fields">
    <fieldset>
        <field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC" id="id" default="0" readonly="true" class="readonly" />
        <field name="old_url" type="redirecturl" label="COM_REDIRECT_FIELD_OLD_URL_LABEL" description="COM_REDIRECT_FIELD_OLD_URL_DESC" class="input-xxlarge" required="true" />
        <field name="target_type" type="radio" label="COM_REDIRECT_FIELD_TARGET_TYPE_LABEL" description="COM_REDIRECT_FIELD_TARGET_TYPE_DESC" class="btn-group" default="internal">
            <option value="internal">COM_REDIRECT_FIELD_TARGET_TYPE_INTERNAL</option>
            <option value="external">COM_REDIRECT_FIELD_TARGET_TYPE_EXTERNAL</option>
        </field>
        <field name="new_url" type="redirecturl" label="COM_REDIRECT_FIELD_NEW_URL_LABEL" description="COM_REDIRECT_FIELD_NEW_URL_DESC" class="input-xxlarge" showon="target_type:internal" />
        <field name="new_url_external" type="url" label="COM_REDIRECT_FIELD_NEW_URL_EXTERNAL_LABEL" description="COM_REDIRECT_FIELD_NEW_URL_EXTERNAL_DESC" class="input-xxlarge" hint="https://" showon="target_type:external" />
        <field name="header" type="redirect" label="COM_REDIRECT_FIELD_REDIRECT_STATUS_CODE_LABEL" description="COM_REDIRECT_FIELD_REDIRECT_STATUS_CODE_DESC" default="0" validate="options" class="input-xlarge" />
        <field name="published" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="chzn-color-state" size="1" default="1">
            <option value="1">JENABLED</option>
            <option value="0">JDISABLED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>
        <field name="comment" type="text" label="COM_REDIRECT_FIELD_COMMENT_LABEL" description="COM_REDIRECT_FIELD_COMMENT_DESC" class="input-xxlarge" size="40" />
        <field name="created_date" type="text" label="COM_REDIRECT_FIELD_CREATED_DATE_LABEL" id="created_date" class="readonly" size="20" readonly="true" filter="unset" />
        <field name="modified_date" type="text" label="COM_REDIRECT_FIELD_UPDATED_DATE_LABEL" id="modified_date" class="readonly" size="20" readonly="true" filter="unset" />
        <field name="hits" type="number" label="COM_REDIRECT_FIELD_HITS_LABEL" id="hits" class="readonly" size="20" readonly="true" filter="unset" />
    </fieldset>
</form>
