<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="3.1" method="upgrade">
    <name>com_wrapper</name>
    <author>Joomla! Project</author>
    <creationDate>April 2006</creationDate>
    <copyright>(C) 2007 Open Source Matters, Inc.
    </copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.md</license>
    <authorEmail>admin@joomla.org</authorEmail>
    <authorUrl>www.joomla.org</authorUrl>
    <version>3.0.0</version>
    <description>COM_WRAPPER_XML_DESCRIPTION</description>
    <files folder="site">
        <filename>controller.php</filename>
        <filename>router.php</filename>
        <filename>wrapper.php</filename>
        <folder>views</folder>
    </files>
    <media folder="media">
        <folder>com_wrapper</folder>
    </media>
    <languages folder="site">
        <language tag="en-GB">language/en-GB.com_wrapper.ini</language>
    </languages>
    <administration>
        <languages folder="admin">
            <language tag="en-GB">language/en-GB.com_wrapper.ini</language>
            <language tag="en-GB">language/en-GB.com_wrapper.sys.ini</language>
        </languages>
    </administration>
    <!-- Extensions which only serve this component, uninstalled with it ("Restore uninstalled core extensions" in Joomla Update brings them back); a shared one stays while another component listing it is installed -->
    <companions>
        <module element="mod_wrapper" client="site" />
    </companions>
</extension>

