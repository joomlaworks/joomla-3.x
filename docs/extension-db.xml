<?xml version="1.0" encoding="utf-8"?>
<!--
    Joomla 3.x (JoomlaWorks Security Distribution) — Update Details, with database requirements
    Hosted via GitHub Pages at https://joomlaworks.github.io/joomla-3.x/extension-db.xml

    Identical to extension.xml, plus <supported_databases>: a site whose database type or version
    isn't listed here is not offered the update (it gets a warning instead).

    Only list.xml rows for sites on 3.16 or newer may point here. Up to and including 3.15 the
    updater read this tag with a bug (lower-case lookup of the XML parser's upper-case attribute
    names), so on those versions it would withhold every update from every site.
    Keep the <update> block in sync with extension.xml on every release.
-->
<updates>
    <update>
        <name>Joomla! 3.16</name>
        <description>Joomla! 3.16 CMS</description>
        <element>joomla</element>
        <type>file</type>
        <version>3.16.0</version>
        <infourl title="Joomla! 3.16.0 — Changelog">https://github.com/joomlaworks/joomla-3.x/blob/main/CHANGELOG.md</infourl>
        <downloads>
            <downloadurl type="full" format="zip">https://github.com/joomlaworks/joomla-3.x/releases/download/rolling/joomla-latest.zip</downloadurl>
        </downloads>
        <tags>
            <tag>stable</tag>
        </tags>
        <maintainer>JoomlaWorks</maintainer>
        <maintainerurl>https://github.com/joomlaworks/joomla-3.x</maintainerurl>
        <section>STS</section>
        <targetplatform name="joomla" version="3\.\d+\.\d+" />
        <php_minimum>7.1.0</php_minimum>
        <supported_databases mysql="5.5.3" mariadb="5.5" postgresql="9.0" mssql="10.50.1600.1" />
    </update>
</updates>
