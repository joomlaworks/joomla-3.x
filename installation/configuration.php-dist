 *
 * -------------------------------------------------------------------------
 * THIS SHOULD ONLY BE USED AS A LAST RESORT WHEN THE WEB INSTALLER FAILS
 *
 * If you are installing Joomla! manually ie not using the web browser installer
 * then rename this file to configuration.php eg
 *
 * UNIX -> mv configuration.php-dist configuration.php
 * Windows -> rename configuration.php-dist configuration.php
 *
 * Now edit this file and configure the parameters for your site and
 * database.
 *
 * Finally move this file to the root folder of your Joomla installation eg
 *
 * UNIX -> mv configuration.php ../
 * Windows -> copy configuration.php ../
 *
 */
class JConfig
{
	public $access = '1';
	public $asset_id = '1';
	public $cache_handler = 'file';
	public $cache_ignored_params = 'aznpid, campid, cof, customid, cx, dclid, dm_i, ef_id, epik, fb_*, fbclid, gad_source, gbraid, gclid, gclsrc, gdffi, gdfms, gdftrk, hsa_*, ie, igshid, irclickid, ito, li_fat_id, matomo_*, mc_*, mkcid, mkevt, mkrid, mkwid, ml_subscriber*, msclkid, mtm_*, nb_klid, ndclid, origin, pcrid, piwik_*, pk_*, redirect_log_mongo_id, redirect_mongo_id, rtid, s_kwcid, sb_referer_host, sccid, siteurl, si, sms_*, srsltid, toolid, trk_*, ttclid, twclid, utm_*, wbraid, yclid, zanpid';
	public $cache_platformprefix = '0';
	public $cachetime = '15';
	public $caching = '0';
	public $captcha = '0';
	public $cookie_domain = '';
	public $cookie_path = '';
	public $date_fields = 'browser';
	public $db = '';                          // DB database name
	public $dbprefix = 'jos_';                // Do not change unless you need to!
	public $dbtype = 'mysqli';                // Normally mysqli
	public $debug = '0';
	public $debug_lang = '0';
	public $debug_lang_const = '1';
	public $display_offline_message = '1';
	public $editor = 'tinymce_latest';
	public $editor_site = '';
	public $error_reporting = 'default';
	public $feed_email = 'none';
	public $feed_limit = 10;
	public $force_ssl = 0;                    // Force areas of the site to be SSL ONLY.  0 = None, 1 = Administrator, 2 = Both Site and Administrator
	public $fromname = '';
	public $frontediting = '0';
	public $ftp_enable = '0';
	public $ftp_host = '';
	public $ftp_pass = '';
	public $ftp_port = '';
	public $ftp_root = '';
	public $ftp_user = '';
	public $gzip = '0';
	public $helpurl = 'https://help.joomla.org/proxy?keyref=Help{major}{minor}:{keyref}&lang={langcode}';
	public $host = 'localhost';               // This is normally set to localhost
	public $lifetime = '15';                  // Session time
	public $link_headers = '1';
	public $list_limit = '50';
	public $live_site = '';                   // Optional, full URL to Joomla install.
	public $log_path = '/administrator/logs'; // This path needs to be writable by Joomla!
	public $mailer = 'mail';
	public $mailfrom = '';
	public $mailonline = '1';
	public $massmailoff = '0';
	public $memcached_compress = '1';
	public $memcached_persist = '1';
	public $memcached_server_host = 'localhost';
	public $memcached_server_port = '11211';
	public $MetaAuthor = '1';
	public $MetaDesc = 'Joomla! - the dynamic portal engine and content management system';
	public $MetaKeys = 'joomla, Joomla';
	public $MetaRights = '';
	public $MetaTitle = '1';
	public $MetaVersion = '0';
	public $offline = '0';
	public $offline_image = '';
	public $offline_message = 'This site is down for maintenance.<br /> Please check back again soon.';
	public $offset = 'UTC';
	public $password = '';                    // DB password
	public $proxy_enable = '0';
	public $proxy_host = '';
	public $proxy_pass = '';
	public $proxy_port = '';
	public $proxy_user = '';
	public $redis_persist = '1';
	public $redis_server_auth = '';
	public $redis_server_db = '0';
	public $redis_server_host = 'localhost';
	public $redis_server_port = '6379';
	public $replyto = '';
	public $replytoname = '';
	public $robots = '';
	public $secret = 'FBVtggIk5lAzEU9H';      // Change this to something more secure
	public $sef = '1';
	public $sef_rewrite = '0';
	public $sef_suffix = '0';
	public $sendmail = '/usr/sbin/sendmail';
	public $session_handler = 'database';
	public $session_memcached_server_host = 'localhost';
	public $session_memcached_server_port = '11211';
	public $session_redis_server_db = '0';
	public $session_redis_server_host = 'localhost';
	public $session_redis_server_port = '6379';
	public $shared_session = '0';
	public $sitename = 'Joomla!';             // Name of Joomla site
	public $sitename_pagetitles = '0';
	public $smtpauth = '0';
	public $smtphost = 'localhost';
	public $smtppass = '';
	public $smtpport = '25';
	public $smtpsecure = 'none';
	public $smtpuser = '';
	public $tmp_path = '/tmp';                // This path needs to be writable by Joomla!
	public $unicodeslugs = '0';
	public $user = '';                        // DB username
}
