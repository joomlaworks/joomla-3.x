<?xml version="1.0" encoding="utf-8"?>
<extension version="3.8" type="plugin" group="captcha" method="upgrade">
    <name>plg_captcha_hcaptcha</name>
    <author>Joomla 3.x UTD Contributors</author>
    <creationDate>October 2026</creationDate>
    <copyright>(C) 2026 JoomlaWorks Ltd. and this project's contributors</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.md</license>
    <authorUrl>https://github.com/joomlaworks/joomla-3.x</authorUrl>
    <version>3.18.0</version>
    <description>PLG_CAPTCHA_HCAPTCHA_XML_DESCRIPTION</description>
    <files>
        <filename plugin="hcaptcha">hcaptcha.php</filename>
    </files>
    <media folder="media">
        <folder>plg_captcha_hcaptcha</folder>
    </media>
    <languages>
        <language tag="en-GB">en-GB.plg_captcha_hcaptcha.ini</language>
        <language tag="en-GB">en-GB.plg_captcha_hcaptcha.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="public_key" type="text" label="PLG_CAPTCHA_HCAPTCHA_PUBLIC_KEY_LABEL" description="PLG_CAPTCHA_HCAPTCHA_PUBLIC_KEY_DESC" default="" required="true" filter="string" size="100" class="input-xxlarge" />
                <field name="private_key" type="text" label="PLG_CAPTCHA_HCAPTCHA_PRIVATE_KEY_LABEL" description="PLG_CAPTCHA_HCAPTCHA_PRIVATE_KEY_DESC" default="" required="true" filter="string" size="100" class="input-xxlarge" />
                <field name="theme" type="list" label="PLG_CAPTCHA_HCAPTCHA_THEME_LABEL" description="PLG_CAPTCHA_HCAPTCHA_THEME_DESC" default="light" filter="string">
                    <option value="light">PLG_CAPTCHA_HCAPTCHA_THEME_LIGHT</option>
                    <option value="dark">PLG_CAPTCHA_HCAPTCHA_THEME_DARK</option>
                </field>
                <field name="size" type="list" label="PLG_CAPTCHA_HCAPTCHA_SIZE_LABEL" description="PLG_CAPTCHA_HCAPTCHA_SIZE_DESC" default="normal" filter="string">
                    <option value="normal">PLG_CAPTCHA_HCAPTCHA_SIZE_NORMAL</option>
                    <option value="compact">PLG_CAPTCHA_HCAPTCHA_SIZE_COMPACT</option>
                    <option value="invisible">PLG_CAPTCHA_HCAPTCHA_SIZE_INVISIBLE</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
