<?xml version="1.0" encoding="utf-8"?>
<extension version="3.8" type="plugin" group="captcha" method="upgrade">
    <name>plg_captcha_iconcaptcha</name>
    <author>Joomla 3.x UTD Contributors</author>
    <creationDate>October 2026</creationDate>
    <copyright>(C) 2026 JoomlaWorks Ltd. and this project's contributors</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.md</license>
    <authorUrl>https://github.com/joomlaworks/joomla-3.x</authorUrl>
    <version>3.18.0</version>
    <description>PLG_CAPTCHA_ICONCAPTCHA_XML_DESCRIPTION</description>
    <files>
        <filename plugin="iconcaptcha">iconcaptcha.php</filename>
        <folder>images</folder>
        <filename>token.php</filename>
        <folder>lib</folder>
    </files>
    <media folder="media">
        <folder>plg_captcha_iconcaptcha</folder>
    </media>
    <languages>
        <language tag="en-GB">en-GB.plg_captcha_iconcaptcha.ini</language>
        <language tag="en-GB">en-GB.plg_captcha_iconcaptcha.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="requirements" type="note" class="alert alert-info" label="PLG_CAPTCHA_ICONCAPTCHA_REQUIREMENTS_LABEL" description="PLG_CAPTCHA_ICONCAPTCHA_REQUIREMENTS_DESC" />
                <field name="theme" type="list" label="PLG_CAPTCHA_ICONCAPTCHA_THEME_LABEL" description="PLG_CAPTCHA_ICONCAPTCHA_THEME_DESC" default="auto" filter="string">
                    <option value="auto">PLG_CAPTCHA_ICONCAPTCHA_THEME_AUTO</option>
                    <option value="light">PLG_CAPTCHA_ICONCAPTCHA_THEME_LIGHT</option>
                    <option value="dark">PLG_CAPTCHA_ICONCAPTCHA_THEME_DARK</option>
                </field>
                <field name="attempts" type="number" label="PLG_CAPTCHA_ICONCAPTCHA_ATTEMPTS_LABEL" description="PLG_CAPTCHA_ICONCAPTCHA_ATTEMPTS_DESC" default="5" min="1" max="20" filter="integer" />
                <field name="credits" type="radio" label="PLG_CAPTCHA_ICONCAPTCHA_CREDITS_LABEL" description="PLG_CAPTCHA_ICONCAPTCHA_CREDITS_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
