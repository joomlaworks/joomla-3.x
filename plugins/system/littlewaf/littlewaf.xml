<?xml version="1.0" encoding="utf-8"?>
<extension version="3.8" type="plugin" group="system" method="upgrade">
    <name>plg_system_littlewaf</name>
    <author>Joomla 3.x UTD Contributors</author>
    <creationDate>August 2026</creationDate>
    <copyright>(C) 2026 JoomlaWorks Ltd. and this project's contributors</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.md</license>
    <authorUrl>https://github.com/joomlaworks/joomla-3.x</authorUrl>
    <version>1.0.0</version>
    <description>PLG_SYSTEM_LITTLEWAF_XML_DESCRIPTION</description>
    <files>
        <filename plugin="littlewaf">littlewaf.php</filename>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.plg_system_littlewaf.ini</language>
        <language tag="en-GB">en-GB/en-GB.plg_system_littlewaf.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="heading_protections" type="spacer" label="PLG_SYSTEM_LITTLEWAF_HEADING_PROTECTIONS" description="PLG_SYSTEM_LITTLEWAF_HEADING_PROTECTIONS_DESC" />
                <field name="filter_sourcerer" type="radio" label="PLG_SYSTEM_LITTLEWAF_FILTER_SOURCERER_LABEL" description="PLG_SYSTEM_LITTLEWAF_FILTER_SOURCERER_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="filter_modulesanywhere" type="radio" label="PLG_SYSTEM_LITTLEWAF_FILTER_MODULESANYWHERE_LABEL" description="PLG_SYSTEM_LITTLEWAF_FILTER_MODULESANYWHERE_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="log_blocked" type="radio" label="PLG_SYSTEM_LITTLEWAF_LOG_BLOCKED_LABEL" description="PLG_SYSTEM_LITTLEWAF_LOG_BLOCKED_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="heading_normalizations" type="spacer" label="PLG_SYSTEM_LITTLEWAF_HEADING_NORMALIZATIONS" description="PLG_SYSTEM_LITTLEWAF_HEADING_NORMALIZATIONS_DESC" />
                <field name="normalize_duplicates" type="radio" label="PLG_SYSTEM_LITTLEWAF_NORMALIZE_DUPLICATES_LABEL" description="PLG_SYSTEM_LITTLEWAF_NORMALIZE_DUPLICATES_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="normalize_question_marks" type="radio" label="PLG_SYSTEM_LITTLEWAF_NORMALIZE_QUESTION_MARKS_LABEL" description="PLG_SYSTEM_LITTLEWAF_NORMALIZE_QUESTION_MARKS_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="normalize_path_ampersand" type="radio" label="PLG_SYSTEM_LITTLEWAF_NORMALIZE_PATH_AMPERSAND_LABEL" description="PLG_SYSTEM_LITTLEWAF_NORMALIZE_PATH_AMPERSAND_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="normalize_search_feeds" type="radio" label="PLG_SYSTEM_LITTLEWAF_NORMALIZE_SEARCH_FEEDS_LABEL" description="PLG_SYSTEM_LITTLEWAF_NORMALIZE_SEARCH_FEEDS_DESC" class="btn-group btn-group-yesno" default="1" filter="uint">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
