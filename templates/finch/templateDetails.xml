<?xml version="1.0" encoding="utf-8"?>
<extension version="3.9" type="template" client="site" method="upgrade">
	<name>finch</name>
	<version>1.0.0</version>
	<creationDate>October 2026</creationDate>
	<author>JoomlaWorks Ltd.</author>
	<authorEmail>contact@joomlaworks.net</authorEmail>
	<authorUrl>https://www.joomlaworks.net</authorUrl>
	<copyright>(C) 2026 JoomlaWorks Ltd. and this project's contributors</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.md</license>
	<description>TPL_FINCH_XML_DESCRIPTION</description>
	<files>
		<filename>component.php</filename>
		<filename>error.php</filename>
		<filename>helper.php</filename>
		<filename>index.php</filename>
		<filename>templateDetails.xml</filename>
		<filename>template_preview.png</filename>
		<filename>template_thumbnail.png</filename>
		<folder>css</folder>
		<folder>html</folder>
		<folder>images</folder>
		<folder>js</folder>
		<folder>language</folder>
	</files>
	<positions>
		<position>navigation</position>
		<position>search</position>
		<position>above-content</position>
		<position>sidebar</position>
		<position>below-content</position>
		<position>footer</position>
		<position>debug</position>
	</positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.tpl_finch.ini</language>
		<language tag="en-GB">en-GB/en-GB.tpl_finch.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="siteName" type="text" label="TPL_FINCH_SITE_NAME_LABEL" description="TPL_FINCH_SITE_NAME_DESC" default="" />
				<field name="tagline" type="text" label="TPL_FINCH_TAGLINE_LABEL" description="TPL_FINCH_TAGLINE_DESC" default="" class="input-xxlarge" />
				<field name="authorBio" type="textarea" label="TPL_FINCH_AUTHOR_BIO_LABEL" description="TPL_FINCH_AUTHOR_BIO_DESC" default="" rows="3" class="input-xxlarge" filter="string" />
				<field name="footerText" type="textarea" label="TPL_FINCH_FOOTER_TEXT_LABEL" description="TPL_FINCH_FOOTER_TEXT_DESC" default="" rows="3" class="input-xxlarge" />
			</fieldset>
			<fieldset name="social" label="TPL_FINCH_FIELDSET_SOCIAL" description="TPL_FINCH_FIELDSET_SOCIAL_DESC">
				<field name="social_x" type="url" label="X" default="" filter="url" class="input-xxlarge" />
				<field name="social_instagram" type="url" label="Instagram" default="" filter="url" class="input-xxlarge" />
				<field name="social_facebook" type="url" label="Facebook" default="" filter="url" class="input-xxlarge" />
				<field name="social_linkedin" type="url" label="LinkedIn" default="" filter="url" class="input-xxlarge" />
				<field name="social_rss" type="text" label="RSS" description="TPL_FINCH_SOCIAL_RSS_DESC" default="" class="input-xxlarge" />
			</fieldset>
		</fields>
	</config>
</extension>
