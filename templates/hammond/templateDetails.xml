<?xml version="1.0" encoding="utf-8"?>
<extension version="3.9" type="template" client="site" method="upgrade">
	<name>hammond</name>
	<version>1.0.0</version>
	<creationDate>October 2026</creationDate>
	<author>JoomlaWorks Ltd.</author>
	<authorEmail>contact@joomlaworks.net</authorEmail>
	<authorUrl>https://www.joomlaworks.net</authorUrl>
	<copyright>(C) 2026 JoomlaWorks Ltd. and this project's contributors</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.md</license>
	<description>TPL_HAMMOND_XML_DESCRIPTION</description>
	<files>
		<filename>component.php</filename>
		<filename>error.php</filename>
		<filename>helper.php</filename>
		<filename>index.php</filename>
		<filename>offline.php</filename>
		<filename>templateDetails.xml</filename>
		<filename>template_preview.png</filename>
		<filename>template_thumbnail.png</filename>
		<folder>css</folder>
		<folder>html</folder>
		<folder>images</folder>
		<folder>js</folder>
		<folder>language</folder>
	</files>
	<positions>
		<position>trending</position>
		<position>masthead</position>
		<position>navigation</position>
		<position>search</position>
		<position>megamenu</position>
		<position>megamenu-aside</position>
		<position>frontpage</position>
		<position>above-content</position>
		<position>sidebar</position>
		<position>below-content</position>
		<position>footer</position>
		<position>debug</position>
	</positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.tpl_hammond.ini</language>
		<language tag="en-GB">en-GB/en-GB.tpl_hammond.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="customCssNote" type="note" class="alert alert-info" label="TPL_HAMMOND_CUSTOM_CSS_LABEL" description="TPL_HAMMOND_CUSTOM_CSS_DESC" />
				<field name="siteName" type="text" label="TPL_HAMMOND_SITE_NAME_LABEL" description="TPL_HAMMOND_SITE_NAME_DESC" default="" />
				<field name="tagline" type="text" label="TPL_HAMMOND_TAGLINE_LABEL" description="TPL_HAMMOND_TAGLINE_DESC" default="" class="input-xxlarge" />
				<field name="footerText" type="textarea" label="TPL_HAMMOND_FOOTER_TEXT_LABEL" description="TPL_HAMMOND_FOOTER_TEXT_DESC" default="" rows="4" class="input-xxlarge" />
				<field name="pagesMenu" type="menu" label="TPL_HAMMOND_PAGES_MENU_LABEL" description="TPL_HAMMOND_PAGES_MENU_DESC" default="companymenu" />
			</fieldset>
			<fieldset name="social" label="TPL_HAMMOND_FIELDSET_SOCIAL" description="TPL_HAMMOND_FIELDSET_SOCIAL_DESC">
				<field name="social_facebook" type="url" label="Facebook" default="#" filter="url" class="input-xxlarge" />
				<field name="social_x" type="url" label="X" default="#" filter="url" class="input-xxlarge" />
				<field name="social_instagram" type="url" label="Instagram" default="#" filter="url" class="input-xxlarge" />
				<field name="social_youtube" type="url" label="YouTube" default="#" filter="url" class="input-xxlarge" />
				<field name="social_linkedin" type="url" label="LinkedIn" default="#" filter="url" class="input-xxlarge" />
				<field name="social_rss" type="text" label="RSS" description="TPL_HAMMOND_SOCIAL_RSS_DESC" default="" class="input-xxlarge" />
			</fieldset>
		</fields>
	</config>
</extension>
