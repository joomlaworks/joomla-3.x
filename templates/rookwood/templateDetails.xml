<?xml version="1.0" encoding="utf-8"?>
<extension version="3.9" type="template" client="site" method="upgrade">
	<name>rookwood</name>
	<version>1.0.0</version>
	<creationDate>October 2026</creationDate>
	<author>JoomlaWorks Ltd.</author>
	<authorEmail>contact@joomlaworks.net</authorEmail>
	<authorUrl>https://www.joomlaworks.net</authorUrl>
	<copyright>(C) 2026 JoomlaWorks Ltd. and this project's contributors</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.md</license>
	<description>TPL_ROOKWOOD_XML_DESCRIPTION</description>
	<files>
		<filename>component.php</filename>
		<filename>error.php</filename>
		<filename>helper.php</filename>
		<filename>index.php</filename>
		<filename>offline.php</filename>
		<filename>templateDetails.xml</filename>
		<filename>template_preview.png</filename>
		<filename>template_thumbnail.png</filename>
		<folder>css</folder>
		<folder>html</folder>
		<folder>images</folder>
		<folder>js</folder>
		<folder>language</folder>
	</files>
	<positions>
		<position>navigation</position>
		<position>header-action</position>
		<position>frontpage</position>
		<position>above-content</position>
		<position>below-content</position>
		<position>footer</position>
		<position>debug</position>
	</positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.tpl_rookwood.ini</language>
		<language tag="en-GB">en-GB/en-GB.tpl_rookwood.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="customCssNote" type="note" class="alert alert-info" label="TPL_ROOKWOOD_CUSTOM_CSS_LABEL" description="TPL_ROOKWOOD_CUSTOM_CSS_DESC" />
				<field name="siteName" type="text" label="TPL_ROOKWOOD_SITE_NAME_LABEL" description="TPL_ROOKWOOD_SITE_NAME_DESC" default="" />
				<field name="defaultTheme" type="list" label="TPL_ROOKWOOD_DEFAULT_THEME_LABEL" description="TPL_ROOKWOOD_DEFAULT_THEME_DESC" default="dark">
					<option value="dark">TPL_ROOKWOOD_THEME_OPTION_DARK</option>
					<option value="light">TPL_ROOKWOOD_THEME_OPTION_LIGHT</option>
					<option value="system">TPL_ROOKWOOD_THEME_OPTION_SYSTEM</option>
				</field>
			</fieldset>
			<fieldset name="footer" label="TPL_ROOKWOOD_FIELDSET_FOOTER">
				<field name="footerHeadline" type="text" label="TPL_ROOKWOOD_FOOTER_HEADLINE_LABEL" description="TPL_ROOKWOOD_FOOTER_HEADLINE_DESC" default="" class="input-xxlarge" />
				<field name="footerEmail" type="email" label="TPL_ROOKWOOD_FOOTER_EMAIL_LABEL" description="TPL_ROOKWOOD_FOOTER_EMAIL_DESC" default="" filter="string" class="input-xlarge" validate="email" />
				<field name="footerText" type="textarea" label="TPL_ROOKWOOD_FOOTER_TEXT_LABEL" description="TPL_ROOKWOOD_FOOTER_TEXT_DESC" default="" rows="3" class="input-xxlarge" />
			</fieldset>
			<fieldset name="social" label="TPL_ROOKWOOD_FIELDSET_SOCIAL" description="TPL_ROOKWOOD_FIELDSET_SOCIAL_DESC">
				<field name="social_x" type="url" label="X" default="" filter="url" class="input-xxlarge" />
				<field name="social_linkedin" type="url" label="LinkedIn" default="" filter="url" class="input-xxlarge" />
				<field name="social_instagram" type="url" label="Instagram" default="" filter="url" class="input-xxlarge" />
				<field name="social_github" type="url" label="GitHub" default="" filter="url" class="input-xxlarge" />
				<field name="social_dribbble" type="url" label="Dribbble" default="" filter="url" class="input-xxlarge" />
				<field name="social_rss" type="text" label="RSS" description="TPL_ROOKWOOD_SOCIAL_RSS_DESC" default="" class="input-xxlarge" />
			</fieldset>
		</fields>
	</config>
</extension>
